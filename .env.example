# Work With OS と共有している Supabase プロジェクトの URL（NEXT_PUBLIC_ 接頭辞だが値自体は非公開情報として扱うこと）
NEXT_PUBLIC_SUPABASE_URL=

# サーバー専用。Supabaseダッシュボード > Project Settings > API > service_role キー。
# 絶対に NEXT_PUBLIC_ を付けない・クライアントに渡さないこと（RLSをバイパスする強い権限のため）。
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar API（面談担当者の実カレンダー連携）。未設定の場合はDBの開発用ダミーデータにフォールバックする。
# 1. Google Cloud Console でプロジェクト作成→「Google Calendar API」を有効化
# 2. 「認証情報」→サービスアカウントを作成→JSONキーを発行
# 3. JSON内の client_email / private_key を以下に設定（private_keyは改行を \n のまま貼り付けてよい）
# 4. 対象のGoogleカレンダー（例：「11_星野」）の共有設定で、このサービスアカウントのメールアドレスを追加
# 5. 対象カレンダーのカレンダーID（カレンダー設定の「カレンダーの統合」欄）を GOOGLE_CALENDAR_ID に設定
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# 学力診断テストの予定を登録する共有カレンダー（例：「02_学診・ガイダンス・体験授業関係」）のID。
# 上と同じサービスアカウントをこのカレンダーにも共有設定する必要がある。未設定の場合はテストの予定登録はスキップされる。
GOOGLE_CALENDAR_ID_TEST=

# スタッフ用申込一覧ページ（/staff）の共有アクセスコード。校舎内でのみ共有すること。
STAFF_ACCESS_CODE=
# cookie署名用のランダム文字列（推測されない値なら何でもよい。例: openssl rand -hex 32）
STAFF_SESSION_SECRET=

# 申込者への確認メール送信（Resend）。未設定の場合はメール送信をスキップする。
# 1. https://resend.com でアカウント作成（無料枠あり）
# 2. 送信元ドメインを認証するか、開発中は resend.dev のテスト用アドレスを使う
# 3. APIキーを発行して以下に設定
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# 新規予約が確定するたびにスタッフへ通知メールを送る宛先。未設定の場合は通知をスキップする（RESEND_*も設定が必要）。
# 複数人に送りたい場合はSTAFF_NOTIFICATION_EMAIL1・EMAIL2も追加で設定できる（設定した分だけ全員に届く）。
STAFF_NOTIFICATION_EMAIL=
STAFF_NOTIFICATION_EMAIL1=
STAFF_NOTIFICATION_EMAIL2=

# 新規予約が確定するたびにLINE公式アカウントからスタッフへPush通知を送る。未設定の場合は通知をスキップする。
# 1. LINE Developers コンソールでMessaging APIチャネルを作成（既存の公式アカウントがあればそれを利用）
# 2. チャネル基本設定の「チャネルアクセストークン（長期）」を発行し LINE_CHANNEL_ACCESS_TOKEN に設定
# 3. 通知を受け取りたいLINEグループ（またはユーザー）のIDを LINE_TARGET_ID に設定
#    グループIDの調べ方: そのグループにBotを招待した状態でWebhookのイベントログ（またはLINE公式アカウントの「友だち・グループ」管理画面）から取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# 申込通知メールの自動取込（/api/mail/*）。値は Vercel の環境変数に設定し、リポジトリには書かない。
# 外部から呼ぶ側と共有する秘密の文字列（40文字以上のランダム値）
MAIL_INGEST_SECRET=
# 校舎メールボックスへのPOP3S接続（暗号化接続のみ。本番で暗号化なしは拒否される）
MAIL_POP_HOST=
MAIL_POP_PORT=995
MAIL_POP_SECURE=tls
MAIL_POP_USER=
MAIL_POP_PASSWORD=
